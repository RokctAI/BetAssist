{
  "name": "betassist",
  "description": "Modular backend package for BetAssist: API-Football data sync into the Match/Team cache, the 'Why Win / Why Lose' insight engine (provider-hook LLM with a deterministic statistical fallback), responsible-gambling profile/bet endpoints, and affiliate outflow deep-link tracking. Tenant-only per the fleet single-gateway rule.",
  "app_type": {
    "tenant": {
      "hooks": {
        "scheduler_events": {
          "hourly": [
            "{app_name}.betassist.tenant.tasks.sync_match_results"
          ],
          "daily": [
            "{app_name}.betassist.tenant.tasks.sync_fixtures",
            "{app_name}.betassist.tenant.tasks.trigger_match_analysis",
            "{app_name}.betassist.tenant.tasks.reset_weekly_unfollows"
          ],
          "monthly": [
            "{app_name}.betassist.tenant.tasks.reset_monthly_budgets"
          ]
        },
        "whitelisted_methods": {
          "{app_name}.api.betassist.register_user": "{app_name}.betassist.tenant.api.betassist.register_user",
          "{app_name}.api.betassist.get_matches_feed": "{app_name}.betassist.tenant.api.betassist.get_matches_feed",
          "{app_name}.api.betassist.log_bet": "{app_name}.betassist.tenant.api.betassist.log_bet",
          "{app_name}.api.betassist.offboard_partner": "{app_name}.betassist.tenant.api.betassist.offboard_partner",
          "{app_name}.api.betassist.update_profile": "{app_name}.betassist.tenant.api.betassist.update_profile",
          "{app_name}.api.betassist.follow_team": "{app_name}.betassist.tenant.api.betassist.follow_team",
          "{app_name}.api.betassist.unfollow_team": "{app_name}.betassist.tenant.api.betassist.unfollow_team",
          "{app_name}.api.betassist.get_affiliate_link": "{app_name}.betassist.tenant.api.betassist.get_affiliate_link"
        }
      }
    },
    "control": {}
  }
}
