{
  // Repo-local config for the shared Code Quality workflow's Markdown Lint job
  // (markdownlint-cli2 runs with CLI globs only, so this file is what it picks
  // up). Default rules stay enabled for everything not listed below.
  "ignores": [
    // Flutter platform scaffolding. `flutter create` writes this README into the
    // iOS project and rewrites it on every compose, so a hand edit is reverted.
    // Its text is Flutter's, not ours; the lint cannot be satisfied at source.
    "ios/Runner/Assets.xcassets/LaunchImage.imageset/README.md"
  ]
}
